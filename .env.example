# ============================================================
# Variables obligatorias (el bot aborta si falta alguna)
# ============================================================
DISCORD_TOKEN=
CLIENT_ID=
# Guild de desarrollo: los slash commands se registran aquí (registro instantáneo)
GUILD_ID=

# ============================================================
# Variables opcionales
# Sin credenciales de Spotify, las URLs se resuelven por búsqueda.
# ============================================================
# SPOTIFY_CLIENT_ID=
# SPOTIFY_CLIENT_SECRET=
# PANEL_DISC_GIF_URL=
# LIVE_TRACE=false
# LOG_TO_FILE=false

# Ruta a un cookies.txt (formato Netscape) para yt-dlp. Vacio = sin cookies.
# YOUTUBE_COOKIES=/app/cookies.txt

# Modo de bajo consumo para VMs pequeñas (e2-micro, 0.25 vCPU).
# Desactiva compresor, reverb, ecualizador y biquads PCM por muestra.
# El volumen sigue funcionando. Recomendado: true en la nube, false en local.
# LOW_CPU_AUDIO=true

# Precarga de la siguiente pista mientras suena la actual. Evita los 17-90 s
# que tarda yt-dlp en entregar el primer byte desde una IP de datacenter.
# PRELOAD_AUDIO=true
# Directorio de trabajo de la precarga (se limpia solo al cambiar de pista).
# PRELOAD_DIR=/app/preload
